PROJECT_NAME=Stress Detection System (ECG/HRV)
VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=false

# Point to folder containing WESAD subject directories (S2, S3, ...)
WESAD_DATA_DIR=data/raw/WESAD

MODELS_DIR=models
LOGS_DIR=logs
PROCESSED_DATA_DIR=data/processed
FEATURES_DATA_DIR=data/features
METADATA_DIR=data/metadata

HOST=0.0.0.0
PORT=8000

ECG_SAMPLING_RATE_HZ=700
WINDOW_SECONDS=60
WINDOW_STEP_SECONDS=60

TRAIN_TEST_SIZE=0.2
RANDOM_STATE=42
CV_FOLDS=5

# Comma-separated origins (optional; defaults include Vite dev server)
# CORS_ORIGINS=http://localhost:5173

LOG_JSON=false
